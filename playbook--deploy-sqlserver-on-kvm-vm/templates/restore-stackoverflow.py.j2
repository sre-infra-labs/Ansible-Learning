#!/usr/bin/env python3
"""
Ansible-generated restore script.
Restores one database from a .bak file with auto-generated MOVE clauses.
Variables are injected by Jinja2 at template-render time on the control node.

File naming convention:
  Primary data file : <DB_NAME>.mdf
  Secondary data    : <DB_NAME>_2.ndf, <DB_NAME>_3.ndf, …
  Log file          : <DB_NAME>.ldf
"""
import glob, subprocess, sys, os

# ── Variables injected by Jinja2 ─────────────────────────────────────────────
SQLCMD   = '/opt/mssql-tools18/bin/sqlcmd'
SERVER   = 'localhost,{{ mssql_port }}'
BAK_FILE = '{{ item.bak_dest }}'
DB_NAME  = '{{ item.name }}'
DEST_DIR = '{{ item.data_destination }}'.rstrip('/')

# SQLCMDPASSWORD is set in the environment by the Ansible task (no_log on template)
env = dict(os.environ)

# ── Step 0: clean up stale RESTORING state + physical files ──────────────────
cleanup_q = (
    f"IF EXISTS (SELECT 1 FROM sys.databases WHERE name = N'{DB_NAME}' "
    f"AND state_desc = 'RESTORING') "
    f"BEGIN DROP DATABASE [{DB_NAME}]; "
    f"PRINT 'Dropped RESTORING database [{DB_NAME}]'; END"
)
r0 = subprocess.run(
    [SQLCMD, '-S', SERVER, '-U', 'sa', '-Q', cleanup_q, '-C', '-N', '-t', '60'],
    capture_output=True, text=True, env=env, timeout=120
)
print(f"Cleanup rc={r0.returncode} | {r0.stdout.strip()} | {r0.stderr.strip()}")

# Delete any pre-existing physical files matching the naming convention
stale_patterns = [
    f'{DEST_DIR}/{DB_NAME}.mdf',
    f'{DEST_DIR}/{DB_NAME}_*.ndf',
    f'{DEST_DIR}/{DB_NAME}.ldf',
]
for pattern in stale_patterns:
    for fpath in glob.glob(pattern):
        os.unlink(fpath)
        print(f"Deleted stale file: {fpath}")
sys.stdout.flush()

# ── Step 1: get logical file list via RESTORE FILELISTONLY ───────────────────
r = subprocess.run(
    [SQLCMD, '-S', SERVER, '-U', 'sa',
     '-Q', f"RESTORE FILELISTONLY FROM DISK = N'{BAK_FILE}';",
     '-s', '|', '-h', '-1', '-W', '-C', '-N'],
    capture_output=True, text=True, env=env
)
if r.returncode != 0:
    print("FILELISTONLY failed:", r.stderr, file=sys.stderr)
    sys.exit(r.returncode)

# Keep only pipe-delimited data rows; skip empty lines and "rows affected" noise
lines = [l.strip() for l in r.stdout.splitlines()
         if l.strip() and 'rows affected' not in l and '|' in l]

data_files = [l.split('|')[0].strip() for l in lines if '|D|' in l]
log_files  = [l.split('|')[0].strip() for l in lines if '|L|' in l]

print(f"Data files : {data_files}")
print(f"Log  files : {log_files}")

if not data_files:
    print("ERROR: no data files found in FILELISTONLY output", file=sys.stderr)
    sys.exit(1)

# ── Step 2: build MOVE clauses ───────────────────────────────────────────────
moves = []
for i, logical_name in enumerate(data_files):
    if i == 0:
        dest = f'{DEST_DIR}/{DB_NAME}.mdf'
    else:
        dest = f'{DEST_DIR}/{DB_NAME}_{i + 1}.ndf'
    moves.append(f"MOVE N'{logical_name}' TO N'{dest}'")

for logical_name in log_files:
    dest = f'{DEST_DIR}/{DB_NAME}.ldf'
    moves.append(f"MOVE N'{logical_name}' TO N'{dest}'")

sql = (
    "EXEC sp_configure 'max server memory (MB)', 4096; RECONFIGURE;\n"
    "GO\n"
    f"RESTORE DATABASE [{DB_NAME}]\n"
    f"FROM DISK = N'{BAK_FILE}'\n"
    f"WITH {','.join(chr(10) + '     ' + m for m in moves)},\n"
    f"     RECOVERY, STATS = 5,\n"
    f"     BUFFERCOUNT = 4,\n"
    f"     MAXTRANSFERSIZE = 65536;"
)

script_path = f'/tmp/restore_{DB_NAME}.sql'
with open(script_path, 'w') as f:
    f.write(sql)

print(f"\nSQL script ({script_path}):\n{sql}\n")
print("Starting RESTORE – this may take several minutes …")
sys.stdout.flush()

# ── Step 3: execute restore ───────────────────────────────────────────────────
# Write output to a file (not a pipe) to prevent buffer-full stalls when SQL
# Server streams STATS progress messages (a full pipe causes a TCP reset).
restore_log = f'/tmp/restore_{DB_NAME}_output.log'
with open(restore_log, 'w') as out_fh:
    r2 = subprocess.run(
        [SQLCMD, '-S', SERVER, '-U', 'sa', '-i', script_path,
         '-C', '-N',
         '-t', '0',    # no query timeout – restore can take many minutes
         '-l', '60'],  # login timeout 60 s
        stdout=out_fh,
        stderr=out_fh,
        env=env,
        timeout=7200,
    )

# Print tail of log for Ansible to capture
try:
    with open(restore_log) as lf:
        content = lf.read()
    print(content[-4000:] if len(content) > 4000 else content)
except Exception as e:
    print(f"Could not read restore log: {e}")

# Cleanup temp files
for f in [script_path, restore_log]:
    try:
        os.unlink(f)
    except Exception:
        pass

sys.exit(r2.returncode)
